# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Simple password gate — set this to require a password to use the app
# Leave blank or remove to disable the password gate
SITE_PASSWORD=

# Resend API key for sending BOV requests to AutoSheets
# Get yours at https://resend.com — free tier = 100 emails/day
RESEND_API_KEY=

# The "from" email address for BOV emails (must be verified in Resend)
BOV_FROM_EMAIL=team@resolute-tools.com
